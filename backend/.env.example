# ── Application ──────────────────────────────────────────────────────────────
HELIOS_ENVIRONMENT=development
HELIOS_SERVICE_NAME=helios-backend
HELIOS_HOST=0.0.0.0
HELIOS_PORT=8000
HELIOS_WORKERS=1
HELIOS_DEBUG=true
HELIOS_FACILITY_ID=FACILITY-001

# ── Redis ─────────────────────────────────────────────────────────────────────
HELIOS_REDIS_HOST=localhost
HELIOS_REDIS_PORT=6379
HELIOS_REDIS_PASSWORD=
HELIOS_REDIS_DB=0
HELIOS_REDIS_SSL=false

# ── SQLite ─────────────────────────────────────────────────────────────────────
HELIOS_SQLITE_PATH=./data/helios_edge.db
# HELIOS_SQLITE_ENCRYPTION_KEY=  # Required in production (SQLCipher)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
HELIOS_POSTGRES_HOST=localhost
HELIOS_POSTGRES_PORT=5432
HELIOS_POSTGRES_DB=helios
HELIOS_POSTGRES_USER=helios
HELIOS_POSTGRES_PASSWORD=helios_dev_password
HELIOS_POSTGRES_SSL=false

# ── JWT (Development uses HS256 auto-fallback — no keys needed in dev) ────────
# HELIOS_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key  # Required in prod
# HELIOS_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key    # Required in prod
HELIOS_JWT_ALGORITHM=HS256

# ── Logging ───────────────────────────────────────────────────────────────────
HELIOS_LOG_LEVEL=DEBUG
HELIOS_LOG_FORMAT=console

# ── MinIO ────────────────────────────────────────────────────────────────────
HELIOS_MINIO_ROOT_USER=helios
HELIOS_MINIO_ROOT_PASSWORD=helios_dev_password

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=helios_grafana
